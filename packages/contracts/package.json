{
	"name": "@skill-tools/contracts",
	"version": "0.1.1",
	"description": "Contract schemas, validation, and audit adapters for browser-agent skills",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"lint": "biome check src/ test/",
		"lint:fix": "biome check --write src/ test/",
		"format": "biome format --write src/ test/",
		"format:check": "biome format src/ test/",
		"clean": "rm -rf dist"
	},
	"keywords": [
		"agent-skills",
		"skill-md",
		"contracts",
		"browser-agent",
		"audit"
	],
	"author": "Piyush Vyas <pyyush>",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/skill-tools/skill-tools",
		"directory": "packages/contracts"
	},
	"homepage": "https://github.com/skill-tools/skill-tools/tree/main/packages/contracts",
	"bugs": {
		"url": "https://github.com/skill-tools/skill-tools/issues"
	},
	"engines": {
		"node": ">=18.0.0"
	},
	"dependencies": {
		"@skill-tools/core": "workspace:*",
		"zod": "^3.25.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.14",
		"@types/node": "^25.2.2",
		"tsup": "^8.5.1",
		"typescript": "^5.9.3",
		"vitest": "^4.0.18"
	}
}
